---
import { Image } from 'astro:assets';
import couple from '../assets/seoul-couple.png';
import Welcome from '../components/Welcome.astro';
import Celebration from '../components/Celebration.astro';
import '../styles/celebration.css';
const title = 'A little forever — Wedding invitation';
---
<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="A romantic, editable wedding invitation inspired by contemporary Seoul stationery. Personalize your names, wedding date, and venue, then print in A5." />
  <meta name="theme-color" content="#f7f5ee" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Sans:wght@400;500;600&family=Nothing+You+Could+Do&display=swap" rel="stylesheet" />
</head>
<body>
  <Welcome />
  <div id="page-content">
  <a class="skip-link" href="#home">Lewati ke isi undangan</a>
  <header class="site-header">
    <a class="wordmark" href="#home" aria-label="A little forever home">a little forever<span>WEDDING STORIES & PAPER THINGS</span></a>
    <nav aria-label="Main navigation"><a href="#invitation">The invitation</a><a href="#rsvp">RSVP</a><a href="#wishes">Ucapan</a><button class="edit-button" id="edit-open">Make it yours <span>↗</span></button></nav>
  </header>
  <main id="home" tabindex="-1">
    <section class="intro" aria-labelledby="page-title">
      <div class="eyebrow"><span></span> A LOVE NOTE, FOR YOU <span></span></div>
      <h1 id="page-title" tabindex="-1">Some things are<br /><em>meant to be.</em><svg class="intro-star" viewBox="0 0 50 65" aria-hidden="true"><path d="M25 1 Q25 32 49 32 Q25 32 25 64 Q25 32 1 32 Q25 32 25 1Z" fill="none" stroke="currentColor" /></svg></h1>
      <p>A little moment. A lifetime of us.<br />And all our favorite people in one place.</p>
      <a class="scroll-link" href="#invitation">YOU'RE INVITED <span>↓</span></a>
      <span class="side-note"><span class="ink-text">the beginning of our forever</span></span>
    </section>
    <section class="invitation-section" id="invitation" aria-label="Wedding invitation">
      <div class="section-label"><span>01 / THE INVITATION</span><span>A DAY TO REMEMBER</span></div>
      <div class="invitation-wrap">
        <span class="hand-note"><span class="ink-text">with love, always</span><svg viewBox="0 0 80 50" aria-hidden="true"><path pathLength="100" d="M3 5 Q48 2 60 36 M48 30 L61 38 L66 24" fill="none" stroke="currentColor" stroke-width="1.2" /></svg></span>
        <article class="invitation" id="print-card">
          <div class="card-top"><span>THE WEDDING OF</span><span>우리의 시작 <span lang="en">/ OUR BEGINNING</span></span></div>
          <h2 data-output="names">[COUPLE'S NAMES]</h2>
          <div class="photo-layout">
            <div class="vertical-text">TWO HEARTS. ONE BEAUTIFUL BEGINNING.</div>
            <figure class="couple-photo"><Image src={couple} alt="A couple sharing a quiet, romantic moment in a sunlit wedding studio" widths={[400, 640, 1024]} sizes="(max-width: 760px) 75vw, 510px" format="webp" quality={80} loading="lazy" decoding="async" /><span class="photo-tape" aria-hidden="true"></span></figure>
            <span class="photo-caption"><span class="ink-text">you, me & forever.</span></span>
            <svg class="flower" viewBox="0 0 100 150" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.3"><path d="M48 145 Q62 95 46 57 M52 113 Q20 118 15 93 Q45 93 52 113 M53 100 Q83 95 88 69 Q62 73 53 100 M46 58 Q18 46 22 18 Q38 25 46 40 Q46 17 60 7 Q73 31 60 48 Q80 27 84 35 Q76 62 46 58Z"/><path d="M40 52 Q32 35 30 28 M54 48 Q61 31 60 18"/></g></svg>
          </div>
          <div class="card-details" id="details">
            <div class="tiny-heart" aria-hidden="true">♡</div>
            <p class="message" data-output="message">Together with our families, we invite you to celebrate our love.</p>
            <p class="wedding-date" data-output="date">[WEDDING DATE]</p>
            <p class="time-venue" data-output="venue">[TIME & VENUE]</p>
          </div>
          <div class="card-footer"><span>A NEW CHAPTER, TOGETHER</span><span class="forever"><span class="ink-text">forever starts here</span></span><span>WITH OUR FAVORITE PEOPLE</span></div>
        </article>
        <span class="bottom-note"><span class="ink-text">a day made of little, lovely things ♡</span></span>
      </div>
    </section>
    <Celebration />
    <section class="closing"><span class="eyebrow">GOOD THINGS ARE BETTER TOGETHER</span><h2>We can't wait to<br /><em>celebrate with you.</em></h2><p>Keep this little love note close.</p><button class="print-button" id="print">Print your invitation <span>↗</span></button><span class="print-info">A5 FORMAT · MADE TO BE KEPT</span></section>
  </main>
  <footer class="site-footer"><span class="wordmark">a little forever</span><span>THOUGHTFULLY MADE. LOVINGLY SHARED.</span><a href="#home">BACK TO THE TOP ↑</a></footer>
  </div>
  <dialog id="editor" aria-labelledby="editor-title"><form id="edit-form"><button class="close" type="button" id="edit-close" aria-label="Close editor">×</button><span class="eyebrow">YOUR STORY, YOUR WORDS</span><h2 id="editor-title">Make it <em>yours.</em></h2><p>Personalize this little piece of your forever.</p><label>Couple's names<input name="names" maxlength="60" placeholder="[COUPLE'S NAMES]" /></label><label>Wedding date<input name="date" maxlength="60" placeholder="[WEDDING DATE]" /></label><label>Time & venue<textarea name="venue" maxlength="180" rows="2" placeholder="[TIME & VENUE]"></textarea></label><label>Your invitation message<textarea name="message" maxlength="240" rows="3"></textarea></label><label>Nama bank<input name="bank" maxlength="50" placeholder="[NAMA BANK]" /></label><label>Nomor rekening<input name="account" maxlength="40" inputmode="numeric" placeholder="[NOMOR REKENING]" /></label><label>Nama pemilik rekening<input name="holder" maxlength="80" placeholder="[NAMA PEMILIK]" /></label><div class="form-actions"><button type="button" id="reset">Reset placeholders</button><button class="print-button" type="submit">Save invitation ↗</button></div><p class="storage-note">Saved in this browser only.</p></form></dialog>
  <div id="toast" role="status" aria-live="polite"></div>
  <script>
    import '../scripts/celebration';
    const defaults = {names: "[COUPLE'S NAMES]", date: '[WEDDING DATE]', venue: '[TIME & VENUE]', message: 'Together with our families, we invite you to celebrate our love.', bank: '[NAMA BANK]', account: '[NOMOR REKENING]', holder: '[NAMA PEMILIK]'};
    type Field = keyof typeof defaults;
    let values = {...defaults};
    try { const saved = JSON.parse(localStorage.getItem('little-forever-invitation') || '{}'); for (const key of Object.keys(defaults) as Field[]) if (typeof saved[key] === 'string' && saved[key].trim()) values[key] = saved[key].slice(0, key === 'message' ? 240 : key === 'venue' ? 180 : key === 'holder' ? 80 : key === 'bank' ? 50 : key === 'account' ? 40 : 60); } catch {}
    const render = () => { for (const key of Object.keys(values) as Field[]) { document.querySelectorAll(`[data-output="${key}"]`).forEach(target => target.textContent = values[key]); } const ready = /^[\d\s-]{5,40}$/.test(values.account); const copy = document.querySelector<HTMLButtonElement>('#copy-account')!; copy.disabled = !ready; document.querySelector('#bank-status')!.textContent = ready ? 'Pastikan nama penerima sesuai sebelum transfer.' : 'Nomor rekening belum diisi.'; };
    const dialog = document.querySelector<HTMLDialogElement>('#editor')!;
    const form = document.querySelector<HTMLFormElement>('#edit-form')!;
    const populate = () => { for (const key of Object.keys(values) as Field[]) (form.elements.namedItem(key) as HTMLInputElement).value = values[key]; };
    document.querySelector('#edit-open')?.addEventListener('click', () => {populate(); dialog.showModal();});
    document.querySelector('#edit-close')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', event => {if (event.target === dialog) {const r = dialog.getBoundingClientRect(); if(event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom) dialog.close();}});
    form.addEventListener('submit', event => {event.preventDefault(); const data = new FormData(form); for (const key of Object.keys(defaults) as Field[]) values[key] = String(data.get(key) || '').trim() || defaults[key]; render(); let persisted = true; try {localStorage.setItem('little-forever-invitation', JSON.stringify(values));} catch { persisted = false; } dialog.close(); const toast = document.querySelector<HTMLElement>('#toast')!; toast.textContent = persisted ? 'Your love note is ready ♡' : 'Perubahan tampil, tetapi belum tersimpan. Penyimpanan browser tidak tersedia.'; toast.classList.add('visible'); setTimeout(() => toast.classList.remove('visible'), 3000);});
    document.querySelector('#reset')?.addEventListener('click', () => {for (const key of Object.keys(defaults) as Field[]) (form.elements.namedItem(key) as HTMLInputElement).value = defaults[key];});
    document.querySelector('#print')?.addEventListener('click', async () => {await document.fonts.ready; window.print();});
    render();
  </script>
</body>
</html>
<style is:global>
  :root{--ivory:#f7f5ee;--ink:#45483e;--muted:#8b8c80;--sage:#777f69;--blush:#eadbd4;--serif:'Cormorant Garamond',Georgia,serif;--sans:'DM Sans',sans-serif;--hand:'Nothing You Could Do',cursive}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:30px}body{margin:0;background:var(--ivory);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased}body:before{content:'';position:fixed;inset:0;pointer-events:none;opacity:.035;z-index:10;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Cpath fill='%23000' filter='url(%23n)' opacity='.5' d='M0 0h180v180H0z'/%3E%3C/svg%3E")}a{color:inherit;text-decoration:none}button,input,textarea{font:inherit}button,a{ -webkit-tap-highlight-color:transparent}button{cursor:pointer}button:focus-visible,a:focus-visible{outline:2px solid var(--sage);outline-offset:5px}.site-header{max-width:1440px;margin:auto;padding:32px 6%;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #dedfd4}.wordmark{font-family:var(--serif);font-size:31px;letter-spacing:-1px;line-height:1}.wordmark>span{display:block;font:8px var(--sans);letter-spacing:2px;margin-top:11px}.site-header nav{display:flex;align-items:center;gap:35px;font-size:12px}.site-header nav a{color:#777c6c}.edit-button{padding:12px 19px;border:1px solid #b5b9a7;border-radius:3px;background:transparent;color:var(--ink);font-size:11px}.edit-button span{margin-left:17px}.intro{position:relative;text-align:center;padding:76px 20px 60px;max-width:1200px;margin:auto}.eyebrow{font-size:9px;letter-spacing:2.5px;display:flex;align-items:center;justify-content:center;gap:15px}.eyebrow>span{height:1px;width:23px;background:#a7ae98}.intro h1{font:400 clamp(60px,7.4vw,100px)/.99 var(--serif);letter-spacing:-3.8px;position:relative;width:fit-content;margin:25px auto}.intro h1 em,.closing h2 em{font-weight:400;color:var(--sage)}.intro-star{position:absolute;width:32px;height:42px;right:-65px;top:29px;color:#8b967a}.intro>p{font-size:12px;line-height:1.9;color:#86887b;margin:23px 0 28px}.scroll-link{font-size:8px;letter-spacing:2px;display:inline-flex;gap:17px;align-items:center}.scroll-link span{font-size:16px}.side-note{position:absolute;left:7%;top:58%;font:15px var(--hand);color:#919781;transform:rotate(-10deg);width:120px;line-height:1.8}.invitation-section{background:#eeeee5;padding:30px 6% 60px;position:relative}.section-label{max-width:1120px;margin:auto;display:flex;justify-content:space-between;color:#909481;font-size:8px;letter-spacing:1.7px}.invitation-wrap{position:relative;max-width:1120px;margin:36px auto 0;display:flex;align-items:center;flex-direction:column}.invitation{width: min(100%,640px);aspect-ratio:148/210;background:#fcfaf5;padding:35px 40px 25px;box-shadow:0 7px 35px #4d514318;position:relative;display:flex;flex-direction:column}.card-top{display:flex;justify-content:space-between;font-size:7px;letter-spacing:1.7px;color:#8a8e7e}.card-top span[lang]{font-size:6px}.invitation h2{text-align:center;font:400 43px/1.05 var(--serif);letter-spacing:-1.2px;margin:26px -12px 23px;overflow-wrap:anywhere}.photo-layout{position:relative;margin:0 28px 0 22px;flex:1;min-height:0}.couple-photo{position:relative;margin:0;width:100%;height:100%;min-height:330px;max-height:460px;background:#e8e3d8;transform:rotate(-2deg)}.couple-photo img{display:block;width:100%;height:100%;position:absolute;object-fit:cover;object-position:center 46%;filter:saturate(.76)}.photo-tape{position:absolute;top:-9px;left:40%;width:85px;height:23px;background:#ede8d6a6;transform:rotate(3deg);clip-path:polygon(2% 0,97% 4%,100% 94%,0 100%)}.vertical-text{position:absolute;left:-28px;top:35%;writing-mode:vertical-rl;transform:rotate(180deg);font-size:6px;letter-spacing:2px;color:#8c8d81}.photo-caption{position:absolute;bottom:-20px;right:-24px;font:25px var(--hand);color:#69755c;transform:rotate(-7deg);white-space:nowrap;z-index:1}.flower{position:absolute;left:-55px;bottom:-30px;width:80px;height:120px;color:#858f74;transform:rotate(-17deg);z-index:2}.card-details{text-align:center;margin:35px 0 19px}.tiny-heart{font-size:20px;color:#89927b;line-height:1}.message{font:italic 19px/1.3 var(--serif);max-width:330px;margin:9px auto 20px;white-space:pre-line;overflow-wrap:anywhere}.wedding-date{font-size:12px;letter-spacing:2.1px;margin:0 0 9px;white-space:pre-line;overflow-wrap:anywhere}.time-venue{font-size:9px;line-height:1.7;letter-spacing:1.2px;margin:0;white-space:pre-line;overflow-wrap:anywhere}.card-footer{border-top:1px solid #deded2;display:flex;justify-content:space-between;align-items:center;padding-top:17px;margin-top:auto;font-size:5px;letter-spacing:1.3px;color:#8a8e7e}.forever{font:italic 16px var(--serif);letter-spacing:0}.hand-note{position:absolute;right:0;top:66px;width:145px;font:21px/1.6 var(--hand);color:#7f896e;transform:rotate(9deg)}.hand-note svg{display:block;width:75px;margin:10px 0 0 -15px;transform:rotate(50deg)}.bottom-note{font:15px var(--hand);color:#8f947e;margin-top:32px;transform:rotate(-3deg)}.closing{text-align:center;padding:76px 20px 72px}.closing h2{font:400 54px/1.05 var(--serif);letter-spacing:-1px;margin:24px 0 18px}.closing p{font-size:12px;color:#858879}.print-button{background:#747e65;border:1px solid #747e65;color:#fffdf6;border-radius:2px;padding:14px 24px;font-size:11px}.closing .print-button{margin-top:14px}.print-button span{margin-left:28px}.print-info{display:block;font-size:7px;letter-spacing:1.8px;color:#9a9d8e;margin-top:16px}.site-footer{margin:0 6%;border-top:1px solid #dcded2;display:flex;justify-content:space-between;align-items:center;padding:27px 0 33px;font-size:7px;letter-spacing:1.8px;color:#858b76}.site-footer .wordmark{font-size:25px;color:var(--ink)}.site-footer a{font-size:7px}dialog{width:min(520px,calc(100% - 32px));border:1px solid #d8dacd;background:#fcfaf5;color:var(--ink);padding:36px;border-radius:4px;box-shadow:0 25px 90px #32372d30}dialog::backdrop{background:#3f463c55;backdrop-filter:blur(5px)}dialog h2{font:44px var(--serif);margin:13px 0}dialog h2 em{color:var(--sage)}dialog p{font-size:12px;color:#848978}dialog .eyebrow{justify-content:flex-start;font-size:8px}.close{position:absolute;right:15px;top:10px;border:0;background:transparent;font-size:25px;color:var(--muted)}label{display:block;font-size:10px;letter-spacing:1px;margin-top:20px}input,textarea{display:block;width:100%;margin-top:8px;padding:11px;border:1px solid #d9dacd;border-radius:2px;background:#f7f5ee;color:var(--ink);font-size:13px;resize:vertical}input:focus,textarea:focus{outline:1px solid var(--sage)}.form-actions{display:flex;gap:12px;justify-content:space-between;align-items:center;margin-top:25px}#reset{border:0;background:none;color:var(--sage);font-size:10px;text-decoration:underline}.storage-note{font-size:9px!important;text-align:center}#toast{position:fixed;bottom:25px;left:50%;transform:translate(-50%,20px);opacity:0;pointer-events:none;transition:.2s;background:var(--ink);color:var(--ivory);padding:14px 22px;font-size:12px;border-radius:3px;z-index:20}#toast.visible{opacity:1;transform:translate(-50%,0)}
  @media(min-width:1200px){.invitation{width:640px}.couple-photo{min-height:415px}}@media(max-width:1000px){.hand-note{right:-10px;width:95px;font-size:16px}.side-note{left:3%;font-size:12px;width:90px}.invitation-wrap{max-width:850px}.invitation{width:570px}.couple-photo{min-height:365px}}@media(max-width:760px){.site-header{padding:23px 6%}.wordmark{font-size:27px}.wordmark>span{font-size:6px;letter-spacing:1.3px}.site-header nav{gap:0}.site-header nav>a{display:none}.edit-button{padding:10px 13px;font-size:10px}.intro{padding:60px 20px 48px}.intro h1{font-size:70px;letter-spacing:-2.5px}.intro-star{right:-25px;top:0;width:21px}.side-note,.hand-note{display:none}.invitation-section{padding:24px 5% 39px}.section-label{font-size:6px;letter-spacing:1.2px}.invitation-wrap{margin-top:26px}.invitation{padding:24px 24px 20px;width:100%;max-width:500px;aspect-ratio:auto;min-height:620px}.card-top{font-size:5px;letter-spacing:1px}.card-top span[lang]{font-size:4px}.invitation h2{font-size:clamp(24px,6.7vw,37px);margin:25px -7px 22px}.photo-layout{margin:0 17px 0 16px}.couple-photo{height:auto;aspect-ratio:1.13;min-height:0;max-height:400px}.vertical-text{left:-22px;font-size:5px}.flower{width:62px;left:-36px;bottom:-26px}.photo-caption{font-size:20px;right:-11px;bottom:-19px}.card-details{margin:34px 0 22px}.message{font-size:17px;max-width:260px;margin-bottom:17px}.wedding-date{font-size:10px}.time-venue{font-size:8px}.card-footer{font-size:4px;letter-spacing:.6px}.forever{font-size:14px}.closing{padding:60px 20px}.closing h2{font-size:46px}.site-footer>span:nth-child(2){display:none}.site-footer{padding:24px 0}.bottom-note{font-size:12px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}#toast{transition:none}}
  @page{size:A5 portrait;margin:0}@media print{*{-webkit-print-color-adjust:exact;print-color-adjust:exact}html,body{margin:0;width:148mm;height:210mm;background:#fcfaf5}body:before,.site-header,.intro,.section-label,.hand-note,.bottom-note,.closing,.site-footer,dialog,#toast{display:none!important}main,.invitation-section,.invitation-wrap{padding:0;margin:0;max-width:none;background:none;display:block}.invitation{width:148mm;height:210mm;min-height:0;aspect-ratio:auto;padding:9mm 10mm 6mm;box-shadow:none;break-inside:avoid}.card-top{font-size:5.5pt}.card-top span[lang]{font-size:4.5pt}.invitation h2{font-size:29pt;margin:6mm -2mm}.photo-layout{margin:0 7mm 0 5mm;flex:1;min-height:0}.couple-photo{height:100%;max-height:none;min-height:0;aspect-ratio:auto}.vertical-text{font-size:4.5pt}.photo-caption{font-size:17pt}.card-details{margin:9mm 0 5mm}.message{font-size:13pt;max-width:90mm;margin:2mm auto 5mm}.wedding-date{font-size:9pt}.time-venue{font-size:7pt}.card-footer{font-size:4pt;padding-top:4mm}.forever{font-size:11pt}}
</style>
