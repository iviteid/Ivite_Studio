---
interface Props { eyebrow?: string; title: string; description?: string; link?: string; linkLabel?: string; }
const { eyebrow, title, description, link, linkLabel } = Astro.props;
---
<div class="mb-9 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
  <div class="max-w-2xl">{eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}<h2 class="display text-4xl font-semibold leading-tight text-ink sm:text-5xl">{title}</h2>{description && <p class="mt-4 leading-7 text-ink/65">{description}</p>}</div>
  {link && <a class="shrink-0 text-sm font-bold text-forest underline decoration-forest/30 underline-offset-8" href={link}>{linkLabel ?? 'Lihat semua'} →</a>}
</div>
