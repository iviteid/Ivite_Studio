<script is:inline>
  (() => {
    const root = document.documentElement;
    let theme = 'dark';
    try {
      const saved = localStorage.getItem('bana-theme');
      if (saved === 'light' || saved === 'dark') theme = saved;
    } catch {}
    const apply = (value) => {
      root.dataset.theme = value;
      document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
        const dark = value === 'dark';
        button.setAttribute('aria-label', dark ? 'Aktifkan tema terang' : 'Aktifkan tema gelap');
        button.setAttribute('aria-pressed', String(!dark));
        button.setAttribute('title', dark ? 'Aktifkan tema terang' : 'Aktifkan tema gelap');
      });
    };
    apply(theme);
    document.addEventListener('DOMContentLoaded', () => apply(root.dataset.theme));
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element) || !event.target.closest('[data-theme-toggle]')) return;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      apply(next);
      try { localStorage.setItem('bana-theme', next); } catch {}
    });
    window.addEventListener('storage', (event) => {
      if (event.key === 'bana-theme') apply(event.newValue === 'light' ? 'light' : 'dark');
    });
  })();
</script>
