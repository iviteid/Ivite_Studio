---
import ThemeInit from '../../components/ThemeInit.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import { books, getCategoryName, type Book } from '../../data/library';
export function getStaticPaths() { return books.map((book) => ({ params: { slug: book.slug }, props: { book } })); }
interface Props { book: Book; }
const { book } = Astro.props;
---
<!doctype html><html lang="id"><head><ThemeInit /><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={`Pembaca buku ${book.title} di Bana.`}/><title>Baca {book.title} — Bana</title><link rel="icon" type="image/png" href="/logo.png"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&family=Newsreader:opsz,wght@6..72,500;6..72,600&display=swap" rel="stylesheet"/><style is:global>@import "../../styles/global.css";</style></head>
<body>
  <header class="sticky top-0 z-40 border-b border-forest/10 site-nav backdrop-blur"><div class="container-shell flex h-16 items-center justify-between"><a href={`/buku/${book.slug}`} class="text-sm font-bold text-forest">← Detail buku</a><p class="hidden truncate px-4 text-sm font-bold text-ink sm:block">{book.title}</p><div class="flex items-center gap-2" aria-label="Ukuran teks"><ThemeToggle /><button data-size="down" class="grid size-9 place-items-center rounded-full border border-forest/15" aria-label="Perkecil teks">A−</button><button data-size="up" class="grid size-9 place-items-center rounded-full border border-forest/15" aria-label="Perbesar teks">A+</button></div></div></header>
  {book.available ? <main class="mx-auto max-w-[760px] px-5 py-16 sm:py-24"><article id="reader" class="rounded-sm bg-[#111d28] px-7 py-14 shadow-xl shadow-forest/5 sm:px-16 sm:py-20"><p class="eyebrow">Cuplikan demonstrasi · {getCategoryName(book.category)}</p><h1 class="display mt-5 text-5xl font-semibold leading-none text-ink sm:text-6xl">{book.title}</h1><p class="mt-5 text-sm font-semibold text-ink/50">{book.author}</p><div class="reader-copy mt-14 space-y-7 text-[19px] leading-[1.9] text-[#c9d8df]"><p><span class="display float-left mr-2 mt-2 text-7xl leading-[.65] text-forest">P</span>engetahuan sering dimulai dari sebuah pertanyaan sederhana. Kita melihat sesuatu yang terasa biasa, lalu berhenti cukup lama untuk bertanya mengapa. Dari jeda kecil itu, pemahaman mulai tumbuh.</p><p>{book.description} Bab contoh ini hadir untuk mendemonstrasikan kenyamanan antarmuka membaca Bana. Isinya bukan kutipan dari karya terbitan mana pun.</p><h2 class="display pt-7 text-3xl font-semibold text-ink">Membaca dengan pelan</h2><p>Membaca bukan perlombaan untuk mencapai halaman terakhir. Ia adalah percakapan antara gagasan penulis, pengalaman pembaca, dan dunia yang terus berubah. Kadang satu paragraf cukup untuk menemani pemikiran sepanjang hari.</p><p>Cuplikan berakhir di sini. Pada implementasi produksi, area ini dapat dihubungkan dengan konten yang memiliki izin distribusi dan metadata hak akses yang terverifikasi.</p></div></article></main> : <main class="container-shell grid min-h-[65vh] place-items-center py-20"><div class="max-w-xl text-center"><span class="display text-7xl text-leaf">◇</span><h1 class="display mt-5 text-5xl font-semibold text-ink">Konten belum tersedia</h1><p class="mt-5 leading-8 text-ink/60">Belum ada file {book.format} untuk buku ini. Bana tidak menampilkan pembaca sampai konten dan hak aksesnya tersedia.</p><a href={`/buku/${book.slug}`} class="mt-8 inline-flex rounded-full bg-forest px-7 py-4 text-sm font-bold text-white">Kembali ke detail</a></div></main>}
  <script>const reader=document.querySelector<HTMLElement>('.reader-copy');let size=19;document.querySelectorAll<HTMLButtonElement>('[data-size]').forEach(button=>button.addEventListener('click',()=>{size=Math.min(25,Math.max(15,size+(button.dataset.size==='up'?1:-1)));if(reader)reader.style.fontSize=`${size}px`;}));</script>
</body></html>
