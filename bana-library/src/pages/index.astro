---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BookCover from '../components/BookCover.astro';
import BookGrid from '../components/BookGrid.astro';
import { books, categories } from '../data/library';
const heroBook = books.find(book => book.slug === 'pikiran-yang-tenang')!;
const featured = books.filter((book) => book.featured).slice(0, 4);
---
<BaseLayout title="Bana — Perpustakaan Digital untuk Pikiran yang Tumbuh" description="Jelajahi koleksi buku digital lintas ilmu di Bana, ruang membaca yang tenang dan mudah digunakan.">
  <section class="hero relative overflow-hidden border-b border-forest/10">
    <div class="container-shell relative grid items-center gap-8 pb-24 pt-16 lg:grid-cols-[1.15fr_1fr] lg:gap-16 lg:py-24">
      <div>
        <p class="hero-badge eyebrow mb-7">Ruang baca. Perspektif baru.</p>
        <h1 class="display hero-title font-semibold text-ink">Buka buku.<br/>Buka <span class="gradient-text">masa depan.</span></h1>
        <p class="mt-7 max-w-lg text-base leading-8 text-ink/65">Satu ruang untuk ribuan kemungkinan. Jelajahi gagasan, temukan perspektif baru, dan biarkan rasa ingin tahu membawamu lebih jauh.</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row"><a href="/perpustakaan" class="rounded-full bg-forest px-7 py-4 text-center text-sm font-bold transition">Jelajahi koleksi ↗</a><a href="/kategori" class="rounded-full border border-white/15 px-7 py-4 text-center text-sm font-bold text-ink transition hover:border-forest/50 hover:bg-forest/5">Temukan bidangmu</a></div>
        <div class="hero-stats"><div><strong>{books.length}<span class="ml-1 text-forest">+</span></strong><span>Buku dalam katalog</span></div><div><strong>{categories.length}</strong><span>Bidang pengetahuan</span></div><div><strong>∞</strong><span>Rasa ingin tahu</span></div></div>
      </div>
      <div class="orbit-scene" aria-label="Pilihan bacaan: Pikiran yang Tenang">
        <div class="orbit-ring" aria-hidden="true"></div><div class="orbit-ring second" aria-hidden="true"></div>
        <a href={`/buku/${heroBook.slug}`} class="hero-cover-link" aria-label={`Lihat buku ${heroBook.title}`}><BookCover book={heroBook} hero/></a>
        <div class="floating-tag top"><b class="text-forest">✦ Pilihan editor</b><span>Gagasan yang layak ditemukan</span></div>
        <div class="floating-tag bottom"><b>◎ Ruang untuk bertumbuh</b><span>Mulai dari satu halaman.</span></div>
      </div>
    </div>
  </section>
  <section class="container-shell -mt-8 relative z-10"><form action="/perpustakaan" class="paper-card flex flex-col gap-3 rounded-2xl p-3 sm:flex-row"><label class="sr-only" for="home-search">Cari buku</label><input id="home-search" name="q" class="min-w-0 flex-1 rounded-xl bg-transparent px-5 py-4 text-base placeholder:text-ink/40" placeholder="Cari judul, penulis, atau topik..."/><button class="rounded-xl bg-forest px-7 py-4 text-sm font-bold text-white">Cari koleksi</button></form></section>
  <section class="container-shell py-24"><SectionHeading eyebrow="Pilihan editor" title="Bacaan untuk memulai" description="Koleksi pilihan yang membuka pintu ke gagasan dan sudut pandang baru." link="/perpustakaan" linkLabel="Lihat koleksi"/><BookGrid books={featured}/></section>
  <section class="container-shell pb-24" aria-labelledby="about-bana">
    <div class="grid gap-10 lg:grid-cols-[.9fr_1.1fr] lg:gap-16">
      <div><p class="eyebrow">Mengenal Bana</p><h2 id="about-bana" class="display mt-4 text-4xl font-semibold leading-tight text-ink sm:text-5xl">Tempat rasa ingin tahu <span class="gradient-text">bertumbuh.</span></h2></div>
      <div><p class="text-lg leading-8 text-ink/75">Bana adalah perpustakaan digital yang menghadirkan ruang untuk menemukan bacaan, menjelajahi gagasan, dan memperluas cara pandang. Kami percaya setiap perjalanan belajar bisa dimulai dari satu halaman.</p><p class="mt-5 leading-8 text-ink/65">Dari teknologi hingga filsafat, setiap bidang menawarkan kesempatan untuk memahami dunia lebih dalam. Bana mengajakmu belajar dengan ritmemu sendiri dan menjadikan membaca bagian kecil yang berarti dalam keseharian.</p><a href="/tentang" class="mt-6 inline-flex text-sm font-bold text-forest underline decoration-forest/30 underline-offset-8">Kenali Bana lebih dekat ↗</a></div>
    </div>
    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {[
        ['01', 'Temukan', 'Ikuti rasa ingin tahumu dan temukan bacaan dari berbagai bidang pengetahuan.'],
        ['02', 'Pahami', 'Luangkan waktu untuk merenungkan gagasan dan melihatnya dari sudut pandang baru.'],
        ['03', 'Bertumbuh', 'Bawa hal yang kamu pelajari ke dalam langkah kecil di kehidupan sehari-hari.'],
      ].map(([number, title, text]) => <article class="paper-card rounded-2xl p-7"><span class="eyebrow">{number} / Perjalananmu</span><h3 class="mt-6 text-xl font-bold text-ink">{title}</h3><p class="mt-3 text-sm leading-7 text-ink/65">{text}</p></article>)}
    </div>
  </section>
  <section class="surface-section py-20 sm:py-24" aria-labelledby="reading-motivation">
    <div class="container-shell">
      <SectionHeading eyebrow="Jeda untuk inspirasi" title="Langkah kecil. Wawasan baru." description="Pengingat sederhana untuk menemani perjalanan membacamu."/>
      <h2 id="reading-motivation" class="sr-only">Motivasi membaca dan belajar</h2>
      <div class="grid gap-5 md:grid-cols-3">
        {[
          ['Mulai', 'Satu halaman hari ini bisa membuka cara pandang baru esok hari.', 'Tidak perlu menunggu waktu yang sempurna. Mulailah dari beberapa menit yang kamu punya.'],
          ['Nikmati', 'Belajar bukan perlombaan. Beri dirimu ruang untuk memahami.', 'Baca perlahan, berhenti sejenak, dan biarkan gagasan menemukan maknanya.'],
          ['Lanjutkan', 'Rasa ingin tahu adalah awal dari setiap kemungkinan.', 'Terus bertanya, terus mencari, dan rayakan setiap hal baru yang kamu pelajari.'],
        ].map(([label, quote, detail]) => <figure class="paper-card flex flex-col rounded-2xl p-7 sm:p-8"><span class="text-3xl text-forest" aria-hidden="true">“</span><blockquote class="display mt-4 flex-1 text-2xl font-semibold leading-snug text-ink">{quote}</blockquote><figcaption class="mt-7 border-t border-forest/15 pt-5"><p class="eyebrow">{label}</p><p class="mt-3 text-sm leading-7 text-ink/65">{detail}</p></figcaption></figure>)}
      </div>
    </div>
  </section>
  <section class="container-shell pt-20 sm:pt-24" aria-labelledby="reading-tips">
    <p class="eyebrow">Tips &amp; trik singkat</p>
    <h2 id="reading-tips" class="display mt-4 text-4xl font-semibold leading-tight text-ink sm:text-5xl">Baca sedikit, pahami lebih banyak.</h2>
    <ol class="mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {[
        ['01', 'Mulai 10 menit', 'Sisihkan 10 menit sehari pada waktu yang paling nyaman untukmu.'],
        ['02', 'Kurangi distraksi', 'Senyapkan notifikasi dan fokus pada satu bacaan.'],
        ['03', 'Catat satu gagasan', 'Tulis inti bacaan dengan kalimatmu sendiri agar lebih mudah diingat.'],
        ['04', 'Coba terapkan', 'Pilih satu hal dari bacaan untuk dicoba dalam keseharian.'],
      ].map(([number, title, text]) => <li class="paper-card rounded-2xl p-6"><span class="eyebrow">{number}</span><h3 class="mt-5 text-lg font-bold text-ink">{title}</h3><p class="mt-3 text-sm leading-7 text-ink/65">{text}</p></li>)}
    </ol>
  </section>
  <section class="container-shell py-24"><div class="overflow-hidden cta-panel rounded-[2rem] px-7 py-16 text-white sm:px-14 lg:grid lg:grid-cols-2 lg:items-center lg:gap-16"><div><p class="eyebrow !text-white/50">Tentang Bana</p><h2 class="display mt-4 text-5xl font-semibold leading-tight">Membaca adalah cara pelan untuk bergerak jauh.</h2></div><div><p class="mt-7 leading-8 text-white/65 lg:mt-0">Kami percaya akses pengetahuan seharusnya terasa sederhana, hangat, dan terbuka. Bana dirancang sebagai tempat membaca tanpa gangguan—untuk siapa pun yang ingin terus belajar.</p><a href="/tentang" class="mt-7 inline-block text-sm font-bold underline decoration-white/30 underline-offset-8">Cerita di balik Bana →</a></div></div></section>
</BaseLayout>
