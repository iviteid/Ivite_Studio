---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCard from '../components/BookCard.astro';
import { books, categories } from '../data/library';
---
<BaseLayout title="Perpustakaan — Jelajahi Koleksi Bana" description="Cari, filter, dan urutkan seluruh koleksi buku digital Bana.">
  <header class="container-shell py-16 sm:py-20"><p class="eyebrow">Katalog Bana</p><div class="mt-4 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between"><h1 class="display text-6xl font-semibold leading-none text-ink sm:text-7xl">Perpustakaan</h1><p class="max-w-md leading-7 text-ink/60">Temukan bacaan berikutnya dari kumpulan gagasan lintas ilmu.</p></div></header>
  <section class="container-shell pb-24">
    <div class="paper-card sticky top-24 z-30 rounded-2xl p-4">
      <div class="grid gap-3 md:grid-cols-[1fr_220px_190px]"><label class="relative"><span class="sr-only">Cari judul atau penulis</span><span class="absolute left-4 top-1/2 -translate-y-1/2 text-ink/35">⌕</span><input id="search" type="search" class="w-full rounded-xl border border-forest/10 bg-[#101b26] py-3.5 pl-11 pr-4 text-sm" placeholder="Judul atau penulis..."/></label><label><span class="sr-only">Filter kategori</span><select id="category" class="w-full rounded-xl border border-forest/10 bg-[#101b26] px-4 py-3.5 text-sm"><option value="all">Semua kategori</option>{categories.map((category) => <option value={category.slug}>{category.name}</option>)}</select></label><label><span class="sr-only">Urutkan buku</span><select id="sort" class="w-full rounded-xl border border-forest/10 bg-[#101b26] px-4 py-3.5 text-sm"><option value="newest">Terbaru</option><option value="oldest">Terlama</option><option value="az">Judul A–Z</option><option value="za">Judul Z–A</option></select></label></div>
    </div>
    <div class="mt-10 flex items-center justify-between"><p id="result-count" class="text-sm font-bold text-ink">{books.length} buku ditemukan</p><button id="reset" class="hidden text-sm font-bold text-forest underline underline-offset-4">Reset filter</button></div>
    <div id="book-list" class="mt-8 grid grid-cols-2 gap-x-5 gap-y-10 md:grid-cols-3 lg:grid-cols-4 xl:gap-x-8">{books.map((book) => <div data-book data-title={book.title.toLowerCase()} data-author={book.author.toLowerCase()} data-category={book.category} data-year={book.publishedYear}><BookCard book={book}/></div>)}</div>
    <div id="empty-state" class="hidden rounded-2xl border border-dashed border-forest/25 py-20 text-center"><span class="display text-5xl text-leaf">⌕</span><h2 class="display mt-4 text-3xl font-semibold text-ink">Buku belum ditemukan</h2><p class="mt-3 text-sm text-ink/55">Coba kata kunci atau kategori yang berbeda.</p></div>
  </section>
  <script>
    const search = document.querySelector<HTMLInputElement>('#search')!;
    const category = document.querySelector<HTMLSelectElement>('#category')!;
    const sort = document.querySelector<HTMLSelectElement>('#sort')!;
    const list = document.querySelector<HTMLElement>('#book-list')!;
    const count = document.querySelector<HTMLElement>('#result-count')!;
    const empty = document.querySelector<HTMLElement>('#empty-state')!;
    const reset = document.querySelector<HTMLButtonElement>('#reset')!;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-book]'));
    const params = new URLSearchParams(location.search);
    search.value = params.get('q') ?? '';
    category.value = params.get('kategori') ?? 'all';
    function update() {
      const term = search.value.trim().toLowerCase();
      const cat = category.value;
      const matching = cards.filter(card => (!term || `${card.dataset.title} ${card.dataset.author}`.includes(term)) && (cat === 'all' || card.dataset.category === cat));
      cards.forEach(card => card.hidden = !matching.includes(card));
      matching.sort((a,b) => { const t = sort.value; if (t === 'az' || t === 'za') return (a.dataset.title ?? '').localeCompare(b.dataset.title ?? '') * (t === 'az' ? 1 : -1); return (Number(b.dataset.year)-Number(a.dataset.year)) * (t === 'newest' ? 1 : -1); }).forEach(card => list.append(card));
      count.textContent = `${matching.length} buku ditemukan`;
      empty.classList.toggle('hidden', matching.length > 0);
      list.classList.toggle('hidden', matching.length === 0);
      reset.classList.toggle('hidden', !term && cat === 'all' && sort.value === 'newest');
    }
    [search, category, sort].forEach(control => control.addEventListener('input', update));
    reset.addEventListener('click', () => { search.value=''; category.value='all'; sort.value='newest'; update(); });
    update();
  </script>
</BaseLayout>
