---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookGrid from '../../components/BookGrid.astro';
import { categories, getBooksByCategory, type Category } from '../../data/library';
export function getStaticPaths() { return categories.map((category) => ({ params: { slug: category.slug }, props: { category } })); }
interface Props { category: Category; }
const { category } = Astro.props;
const categoryBooks = getBooksByCategory(category.slug);
---
<BaseLayout title={`${category.name} — Kategori Bana`} description={category.description}>
  <header class="border-b border-forest/10 surface-section"><div class="container-shell py-20"><a href="/kategori" class="text-sm font-bold text-forest">← Semua kategori</a><div class="mt-10 grid gap-8 md:grid-cols-[1fr_.45fr] md:items-end"><div><span class="display text-5xl text-leaf">{category.icon}</span><h1 class="display mt-5 text-6xl font-semibold leading-none text-ink sm:text-7xl">{category.name}</h1><p class="mt-6 max-w-2xl text-lg leading-8 text-ink/60">{category.description}</p></div><p class="md:text-right"><span class="display text-6xl text-forest">{categoryBooks.length}</span><br/><span class="eyebrow">buku dalam katalog</span></p></div></div></header>
  <section class="container-shell py-20"><BookGrid books={categoryBooks}/></section>
</BaseLayout>
